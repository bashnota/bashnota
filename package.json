{
  "name": "bashnota",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.14.0 <23",
    "npm": ">=10.9.2 <11"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "build:analyze": "VITE_SUPABASE_URL=http://127.0.0.1:54321 VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH BUNDLE_ANALYZE=1 vite build",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:fast": "node scripts/test-results-policy.self-test.mjs && vitest run --reporter=default --reporter=junit --outputFile.junit=test-results/vitest-junit.xml && node scripts/test-results-policy.mjs",
    "test:coverage": "vitest run --silent --config vitest.coverage.config.ts --coverage",
    "test:ci:unit": "node scripts/test-results-policy.self-test.mjs && vitest run --silent=passed-only --config vitest.coverage.config.ts --coverage --reporter=default --reporter=junit --outputFile.junit=test-results/vitest-junit.xml && node scripts/test-results-policy.mjs",
    "test:performance": "vitest run src/test/performance --reporter=verbose",
    "test:iframe-security": "vite-node e2e/iframe-output-sandbox.browser.ts",
    "test:export-security": "node scripts/export-security-gate.self-test.mjs && vite-node e2e/export-security.browser.ts",
    "test:jupyter-security": "node scripts/jupyter-security-gate.self-test.mjs && vite-node e2e/jupyter-auth.browser.ts",
    "test:jupyter-local": "node e2e/jupyter-local.smoke.mjs",
    "test:jupyter-ui": "playwright test --config playwright.jupyter.config.ts && node scripts/test-results-policy.mjs test-results/jupyter-ui-junit.xml",
    "test:deploy-workflow": "node scripts/refuse-stale-deploy.self-test.mjs && node scripts/deploy-workflow.self-test.mjs",
    "test:github-pages-deep-links": "node scripts/github-pages-deep-links.self-test.mjs && vitest run src/router/__tests__/deepLinks.test.ts",
    "test:initial-route-assets": "node scripts/initial-route-assets.self-test.mjs && vite-node e2e/initial-route-assets.browser.mjs",
    "test:container": "node scripts/container-smoke-test.mjs",
    "test:playwright": "playwright test && node scripts/test-results-policy.mjs test-results/playwright-junit.xml",
    "test:pwa": "VITE_SUPABASE_URL=http://127.0.0.1:54321 VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH npm run build-only && node scripts/pwa-artifact-gate.mjs && playwright test --config playwright.pwa.config.ts && node scripts/test-results-policy.mjs test-results/pwa-junit.xml",
    "test:browser-e2e": "npm run test:playwright && npm run test:pwa && npm run test:iframe-security && npm run test:export-security && npm run test:jupyter-security && npm run test:github-pages-deep-links && npm run test:initial-route-assets",
    "test:emulator-e2e": "npm run test:supabase && npm run test:browser-e2e",
    "test:supabase": "npx --yes supabase@2.114.0 db reset && npx --yes supabase@2.114.0 test db && npm run test:supabase:migration && npm run test:supabase:auth && npm run test:supabase:publishing && npm run test:supabase:community && npm run test:supabase:storage && npm run test:supabase:api-security",
    "test:migration-engine": "node supabase/tests/migration/migration.engine.self-test.mjs",
    "test:supabase:migration": "node supabase/tests/migration/migration.rehearsal.mjs",
    "migration:legacy": "node scripts/legacy-migration/cli.mjs",
    "migration:legacy:export": "node scripts/legacy-migration/export-cli.mjs",
    "test:supabase:auth": "node supabase/tests/auth/auth.integration.mjs",
    "test:supabase:publishing": "node supabase/tests/publishing/publishing.integration.mjs && RUN_SUPABASE_PUBLISHING_INTEGRATION=true vitest run src/features/nota/stores/__tests__/notaPublishing.integration.test.ts",
    "test:supabase:community": "node supabase/tests/community/community.integration.mjs",
    "test:supabase:storage": "node supabase/tests/storage/published-images.integration.mjs",
    "test:supabase:api-security": "node supabase/tests/api/api-security.integration.mjs",
    "test:supabase:upgrade": "npx --yes supabase@2.114.0 db reset --version 20260813000200 --sql-paths ./upgrade/003_legacy_edges_fixture.sql && npx --yes supabase@2.114.0 migration up --local && npx --yes supabase@2.114.0 test db supabase/upgrade/003_upgrade.test.sql",
    "supabase:start": "npx --yes supabase@2.114.0 start",
    "supabase:reset": "npx --yes supabase@2.114.0 db reset",
    "supabase:lint": "npx --yes supabase@2.114.0 db lint --local --level error",
    "supabase:types": "npx --yes supabase@2.114.0 gen types typescript --local --schema public > supabase/types/database.types.ts",
    "build-only": "vite build",
    "check:backend-purity": "node scripts/check-backend-purity.mjs",
    "check:repository-hygiene": "node scripts/repository-hygiene.self-test.mjs",
    "release:self-test": "node scripts/release/release-readiness.self-test.mjs",
    "release:licenses": "node scripts/release/generate-license-report.mjs",
    "release:sbom": "node scripts/release/generate-sbom.mjs",
    "release:package": "node scripts/release/package-release.mjs",
    "release:github-metadata": "node scripts/release/export-github-metadata.mjs",
    "release:check": "npm run check:repository-hygiene && npm run check:backend-purity && npm run release:self-test && npm run type-check && npm run type-check:e2e && npm run lint:ratchet && npm run test:fast && npm run build",
    "type-check": "vue-tsc --build",
    "type-check:e2e": "tsc --build tsconfig.e2e.json",
    "lint": "eslint . --max-warnings 309",
    "lint:ratchet": "eslint . --quiet --max-warnings 309",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write src/"
  },
