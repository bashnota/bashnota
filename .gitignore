# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
*.lcov

# Vitest CI results (uploaded as a job artifact by .github/workflows/ci.yml)
test-results/
reports/bundle-visualizer.html

# nyc test coverage
.nyc_output

# Grunt intermediate storage (https://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/
jspm_packages/

# Snowpack dependency directory (https://snowpack.dev/)
web_modules/

# TypeScript cache
*.tsbuildinfo

# Guard: src/ is TypeScript-only. Never commit JavaScript emitted into src/ by
# a misconfigured `vue-tsc --build` (tsconfig lacking noEmit). See tsconfig.*.json.
src/**/*.js
src/**/*.js.map

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Microbundle cache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# Local environment and shell configuration. Keep only deliberately public
# templates; every real dotenv variant is private regardless of directory or
# environment suffix.
.env
.env.*
!.env.example
!.env.*.example
.envrc
.envrc.*
!.envrc.example
!.envrc.*.example

# Local provider credentials and emulator/runtime state.
**/.runtimeconfig.json
**/.secret.local
**/.secrets.local
.firebase/
firebase-debug.log*
firestore-debug.log*
ui-debug.log*
.supabase/
supabase/.temp/
supabase/.branches/

# Private key stores and downloaded provider credentials. Public templates
# should use a `.example` suffix instead of a credential-like filename.
*.[pP][eE][mM]
*.[kK][eE][yY]
*.[pP]12
*.[pP][fF][xX]
*.[jJ][kK][sS]
*.[kK][eE][yY][sS][tT][oO][rR][eE]
id_rsa
id_dsa
id_ecdsa
id_ed25519
*service-account*.json
*service_account*.json
*serviceAccount*.json
*firebase-adminsdk*.json
google-services.json
GoogleService-Info.plist

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# Next.js build output
.next
out

# Nuxt.js build / generate output
.nuxt
dist

# Gatsby files
.cache/
# Comment in the public line in if your project uses Gatsby and not Next.js
# https://nextjs.org/blog/next-9-1#public-directory-support
# public

# vuepress build output
.vuepress/dist

# vuepress v2.x temp and cache directory
.temp
.cache

# Docusaurus cache and generated files
.docusaurus

# Serverless directories
.serverless/

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# TernJS port file
.tern-port

# Stores VSCode versions used for testing VSCode extensions
.vscode-test

# yarn v2
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# Keep generated/private public assets out, while allowing the checked-in PWA
# install icon required by the production manifest.
public/*
!public/icons/
!public/robots.txt
public/icons/*
!public/icons/app-icon.svg

.vscode/

md_context/

# The dacli workspace lives on its own ref (dacli-record), not on trunk: records
# carried on a branch fork with it, so a task closed on a task branch is
# invisible on trunk until its record merges. The history is NOT lost —
#   git log dacli-record
#   git show dacli-record:.dacli/projects/<p>/tasks/done/<file>
.dacli/
.codex/
# Locally generated release artifacts and optional collaboration exports.
/release/
